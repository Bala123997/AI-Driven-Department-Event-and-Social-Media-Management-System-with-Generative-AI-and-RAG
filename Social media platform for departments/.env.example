API_PORT=3001
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace_with_your_mysql_password
DB_NAME=kare_cse_social

# ChromaDB vector index (start ChromaDB on this host and port before semantic chat queries)
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000
CHROMA_COLLECTION=kare_approved_events
CHROMA_MIN_SIMILARITY=0.05

# Google Calendar OAuth
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-web-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback
GOOGLE_FRONTEND_REDIRECT_URI=http://localhost:5173/prototype/index.html
GOOGLE_CALENDAR_TIMEZONE=Asia/Kolkata
APP_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Optional AI-generated notification wording. The built-in fallback works without these settings.
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini
AI_NOTIFICATION_TIMEOUT_MS=8000

# Gmail SMTP settings for real email delivery.
# Enable 2-Step Verification in Google, then create a 16-character App Password.
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-gmail-app-password
EMAIL_FROM=your-gmail-address@gmail.com

# Optional passwords for local demo-account test helpers.
TEST_FACULTY_PASSWORD=
TEST_COORDINATOR_PASSWORD=
TEST_ADMIN_PASSWORD=
TEST_GENERAL_PASSWORD=